{
    "name": "ha-sip-ng",
    "version": "10.0-rc1",
    "slug": "ha-sip-ng",
    "url": "https://github.com/arnonym/ha-plugins",
    "description": "Home-Assistant SIP Gateway, next generation (Kotlin/JVM)",
    "arch": [
        "aarch64",
        "amd64"
    ],
    "image": "ghcr.io/arnonym/ha-plugins/{arch}-ha-sip-ng",
    "init": "false",
    "startup": "application",
    "boot": "auto",
    "options": {
        "sip_global": {
            "port": 5060,
            "log_level": 5,
            "name_server": "",
            "cache_dir": "",
            "global_options": ""
        },
        "sip": [
            {
                "enabled": true,
                "registrar_uri": "sip:fritz.box",
                "id_uri": "sip:homeassistant@fritz.box",
                "realm": "*",
                "user_name": "homeassistant",
                "password": "secure",
                "answer_mode": "listen",
                "settle_time": 1,
                "incoming_call_file": "",
                "options": ""
            }
        ],
        "tts": {
            "engine_id": "",
            "platform": "",
            "language": "",
            "voice": "",
            "debug_print": false
        },
        "webhook": {
            "id": "sip_call_webhook_id"
        },
        "sensors": {
            "enabled": false,
            "entity_prefix": "ha_sip"
        }
    },
    "schema": {
        "sip_global": {
            "port": "int",
            "log_level": "int",
            "name_server": "str",
            "cache_dir": "str",
            "global_options": "str"
        },
        "sip": [
            {
                "enabled": "bool",
                "registrar_uri": "str",
                "id_uri": "str",
                "realm": "str",
                "user_name": "str",
                "password": "str",
                "answer_mode": "list(listen|accept|reject)",
                "settle_time": "float",
                "incoming_call_file": "str",
                "options": "str"
            }
        ],
        "tts": {
            "platform": "str?",
            "engine_id": "str?",
            "language": "str",
            "voice": "str?",
            "debug_print": "bool?"
        },
        "webhook": {
            "id": "str"
        },
        "sensors": {
            "enabled": "bool",
            "entity_prefix": "str"
        }
    },
    "host_network": true,
    "homeassistant_api": true,
    "hassio_api": false,
    "stdin": true,
    "map": [
        {
            "type": "homeassistant_config",
            "read_only": false,
            "path": "/config"
        },
        {
            "type": "media",
            "read_only": false,
            "path": "/media"
        }
    ]
}
